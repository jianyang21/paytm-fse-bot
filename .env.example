# Copy to .env and fill in.
SARVAM_API_KEY=
# Redis: plan/FSE cache + Sarvam rate limiter. Upstash: rediss://default:<pw>@<host>:6379
REDIS_URL=redis://localhost:6379/0
# Optional override.
# SARVAM_BASE_URL=https://api.sarvam.ai/v1

# FSE WhatsApp bot (Vonage sandbox)
VONAGE_API_KEY=
VONAGE_API_SECRET=
# VONAGE_WHATSAPP_FROM=14157386102
# Your WhatsApp number joined to the sandbox, e.g. 919876543210
FSE_PHONE=
# Optional: WhatsApp number that gets the 22:00 health alert when something failed
ALERT_PHONE=
# Postgres (Neon: use the direct, non -pooler connection string)
DATABASE_URL=
# Tests only: a Postgres the tests may create/drop schemas in (can be the same Neon DB)
# TEST_DATABASE_URL=
# PORT=5000

# Collections manager: 9 am brief (Resend) + /collections inbox (basic auth, password below)
RESEND_API_KEY=
MANAGER_EMAIL=
MANAGER_TOKEN=
# Needs a verified domain; default is Resend's test sender (delivers only to your own address)
# BRIEF_FROM=Collections <no-reply@yourdomain>

# Support desk: /support review queue (basic auth). The demo key-account merchants' KAM is
# kam@example.com, so use that email for the KAM login in the demo.
SUPPORT_KAM_EMAIL=
SUPPORT_KAM_TOKEN=
SUPPORT_AGENT_EMAIL=
SUPPORT_AGENT_TOKEN=
